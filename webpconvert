#!/usr/bin/env python3
import os
import sys
import subprocess
import glob
import base64
import json
import urllib.request
import argparse
import shutil
import re

def check_tools():
    if subprocess.call(["which", "cwebp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
        print("⚠️ 'cwebp' non installato. Provo con brew...")
        subprocess.run(["brew", "install", "webp"])
    if subprocess.call(["which", "exiftool"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
        print("⚠️ 'exiftool' non installato. Lancia: brew install exiftool")

def remove_background(input_path, output_path):
    rembg_path = shutil.which("rembg") or os.path.expanduser("~/.local/bin/rembg")
    if not rembg_path or not os.path.exists(rembg_path):
        print("❌ 'rembg' non trovato. Lancia: pipx install 'rembg[cpu,cli]'")
        return False
    print("🪄 Rimuovo sfondo (AI)... attendere.")
    res = subprocess.run([rembg_path, "i", input_path, output_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return res.returncode == 0

def clean_filename(title):
    title = title.lower().strip()
    title = re.sub(r'[\s_]+', '-', title)
    title = re.sub(r'[^a-z0-9\-]', '', title)
    title = re.sub(r'-+', '-', title)
    return title[:50].rstrip('-').strip('-')

def generate_ai(image_path):
    api_key = os.environ.get("OPENAI_API_KEY", "dummy_key")

    with open(image_path, "rb") as f:
        img_data = base64.b64encode(f.read()).decode("utf-8")

    ext = image_path.lower().split('.')[-1]
    mime_map = {
        "jpg": "image/jpeg",
        "jpeg": "image/jpeg",
        "png": "image/png",
        "webp": "image/webp"
    }
    mime = mime_map.get(ext, "image/jpeg")

    prompt_text = (
        "Analyze product image. Return ONLY valid JSON. "
        "Format: {\"titolo\": \"...\", \"descrizione\": \"...\"}. "
        "Rules: 'titolo' max 50 chars, concise SEO/ecommerce filename slug on italian language; "
        "'descrizione' max 160 chars, short SEO-optimized description suitable for ALT text on italian language. "
        "No markdown, no extra text."
    )

    payload = {
        "model": "pplx-web/pplx-opus",
        "messages": [{
            "role": "user",
            "content": [
                {"type": "text", "text": prompt_text},
                {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{img_data}"}}
            ]
        }]
    }

    req = urllib.request.Request(
        "http://localhost:20128/v1/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
    )

    try:
        with urllib.request.urlopen(req) as res:
            res_data = json.loads(res.read().decode("utf-8"))
            text = res_data["choices"][0]["message"]["content"]

            if "```json" in text:
                text = text.split("```json")[1].split("```")[0].strip()
            elif "```" in text:
                text = text.split("```")[1].strip()

            return json.loads(text)
    except Exception as e:
        print(f"❌ Errore API AI su {image_path}: {e}")
        return None

def write_metadata(webp_path, meta):
    titolo = str(meta.get('titolo', '')).strip()
    desc = str(meta.get('descrizione', '')).strip()[:160]
    cmd = [
        "exiftool",
        "-overwrite_original",
        f"-Title={titolo}",
        f"-Description={desc}",
        webp_path
    ]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"📝 Dettagli aggiunti in EXIF/XMP")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("dir", nargs="?", default=".")
    parser.add_argument("-a", "--ai", action="store_true", help="Usa AI per rinominare e metadata")
    parser.add_argument("-b", "--bg", action="store_true", help="Rimuove sfondo")
    args = parser.parse_args()

    check_tools()
    if not os.path.isdir(args.dir):
        sys.exit(f"❌ '{args.dir}' non directory.")

    webp_dir = os.path.join(args.dir, "webp")
    os.makedirs(webp_dir, exist_ok=True)
    converted = False

    extensions = ["jpg", "jpeg", "png", "webp"]
    all_files = []
    for ext in extensions:
        all_files.extend(glob.glob(os.path.join(args.dir, "*." + ext)))
        all_files.extend(glob.glob(os.path.join(args.dir, "*." + ext.upper())))

    # Deduplica e ordina
    all_files = sorted(list(set(all_files)))

    for f in all_files:
        base = os.path.splitext(os.path.basename(f))[0]
        ext = os.path.splitext(f)[1].lower().lstrip('.')
        is_already_webp = (ext == "webp")

        target_file = f
        temp_png = None
        if args.bg:
            temp_png = os.path.join(webp_dir, base + "_nobg.png")
            if remove_background(f, temp_png):
                target_file = temp_png
            else:
                print(f"⚠️ Rimozione sfondo fallita per {f}")

        new_name = base
        meta = None
        if args.ai:
            meta = generate_ai(f)
            if meta and "titolo" in meta and meta["titolo"]:
                cleaned = clean_filename(meta["titolo"])
                if cleaned:
                    new_name = cleaned

        w_path = os.path.join(webp_dir, new_name + ".webp")

        count = 1
        while os.path.exists(w_path):
            w_path = os.path.join(webp_dir, f"{new_name}_{count}.webp")
            count += 1

        # Se già webp e senza rimozione sfondo -> copia diretta, no ricompressione
        if is_already_webp and not args.bg:
            if args.ai and not meta:
                print(f"⚠️ AI fallita, non faccio nulla")
                #subprocess.run(["cwebp", "-quiet", target_file, "-o", w_path])
            else:
                print(f"✅ Copio e aggiorno metadata → {w_path}")
                shutil.copy2(target_file, w_path)
        else:
            print(f"✅ Convertendo → {w_path}")
            subprocess.run(["cwebp", "-quiet", target_file, "-o", w_path])

        converted = True

        if meta:
            write_metadata(w_path, meta)

        if args.bg and temp_png and os.path.exists(temp_png):
            os.remove(temp_png)

    if not converted:
        print("ℹ️ Nessuna immagine trovata.")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n🛑 Operazione interrotta dall'utente.")
        sys.exit(130)